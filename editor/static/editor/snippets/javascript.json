            "function debounce(func, delay) {",
            "\tlet timeoutId;",
            "\treturn function() {",
            "\t\tclearTimeout(timeoutId);",
            "\t\ttimeoutId = setTimeout(() => func.apply(this, arguments), delay);",
            "\t};",
            "}"
        ],
        "description": "Debounce function"
    },
