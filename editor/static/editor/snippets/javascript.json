    "Throttle Function": {
        "prefix": "throttle",
        "body": [
            "function throttle(func, limit) {",
            "\tlet inThrottle;",
            "\treturn function() {",
            "\t\tconst args = arguments;",
            "\t\tconst context = this;",
            "\t\tif (!inThrottle) {",
            "\t\t\tfunc.apply(context, args);",
            "\t\t\tinThrottle = true;",
            "\t\t\tsetTimeout(() => inThrottle = false, limit);",
            "\t\t}",
            "\t};",
            "}"
        ],
        "description": "Throttle function"
    },
    "Debounce Function": {
