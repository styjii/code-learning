# Copiez ce fichier vers « .env » puis adaptez les valeurs. Ne commitez JAMAIS « .env ».

# --- Obligatoire -------------------------------------------------------------
# Clé secrète unique. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# --- Général -----------------------------------------------------------------
# 1 = développement (erreurs détaillées) ; 0 = production
DJANGO_DEBUG=0
# Hôtes autorisés, séparés par des virgules (obligatoire si DJANGO_DEBUG=0)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS de confiance pour les formulaires (ex. https://cours.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS (production) ---------------------------------------------------------
# 1 = cookies « Secure », redirection HTTP -> HTTPS. Par défaut : actif si DJANGO_DEBUG=0.
DJANGO_HTTPS=
# Durée HSTS en secondes (0 = désactivé). Ex. 31536000 une fois HTTPS validé.
DJANGO_HSTS_SECONDS=0
# 1 si l'application est derrière un proxy inverse qui envoie X-Forwarded-Proto
DJANGO_BEHIND_PROXY=0

# --- Authentification ----------------------------------------------------------
# Durée d'une session, en heures
DJANGO_SESSION_HOURS=168
# Échecs de connexion tolérés avant blocage, et durée du blocage (secondes)
DJANGO_LOGIN_MAX_ATTEMPTS=5
DJANGO_LOGIN_LOCKOUT_SECONDS=900

# --- Import .zip de l'éditeur (protection contre les archives piégées) ----------
# Tailles en Ko. Valeurs par défaut ci-dessous ; au-delà l'import est refusé (HTTP 413).
# EDITOR_ZIP_MAX_UPLOAD_KB=5120     # taille du fichier .zip envoyé
# EDITOR_ZIP_MAX_FILE_KB=1024       # taille décompressée d'un fichier (index.html, style.css, script.js / script.ts, tsconfig.json)
# EDITOR_ZIP_MAX_TOTAL_KB=5120      # total décompressé de toute l'archive
# EDITOR_ZIP_MAX_ENTRIES=100        # nombre de fichiers dans l'archive

# --- Compte administrateur initial (utilisé par « createsuperuser --noinput ») ------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
