# Copiez ce fichier vers « .env » puis adaptez les valeurs. Ne commitez JAMAIS « .env ».

# --- Obligatoire -------------------------------------------------------------
# Clé secrète unique. Pour en générer une :
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# --- Général -----------------------------------------------------------------
# 1 = développement (erreurs détaillées) ; 0 = production
DJANGO_DEBUG=0
# Hôtes autorisés, séparés par des virgules (obligatoire si DJANGO_DEBUG=0)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS de confiance pour les formulaires (ex. https://cours.example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS (production) ---------------------------------------------------------
# 1 = cookies « Secure », redirection HTTP -> HTTPS. Par défaut : actif si DJANGO_DEBUG=0.
DJANGO_HTTPS=
# Durée HSTS en secondes (0 = désactivé). Ex. 31536000 une fois HTTPS validé.
DJANGO_HSTS_SECONDS=0
# 1 si l'application est derrière un proxy inverse (nginx, Apache, Traefik…). Active la lecture de
# X-Forwarded-Proto et de l'IP réelle du client (sinon tous les visiteurs partagent l'IP du proxy).
DJANGO_BEHIND_PROXY=0
# Proxys de confiance : IP ou réseaux CIDR, séparés par des virgules. L'en-tête d'IP n'est cru que si la
# connexion TCP vient d'un de ces proxys. Vide = loopback + réseaux privés (127/8, 10/8, 172.16/12, 192.168/16, ::1, fc00::/7).
DJANGO_TRUSTED_PROXIES=
# En-tête qui porte l'IP du client. X-Forwarded-For (par défaut), ou X-Real-IP / CF-Connecting-IP.
DJANGO_PROXY_IP_HEADER=X-Forwarded-For

# --- Cache partagé (compteurs de tentatives de connexion) ---------------------------
# Obligatoire en production dès qu'il y a plusieurs processus/workers : un cache en mémoire locale donnerait
# un compteur par processus (la limite serait multipliée par leur nombre).
#   redis://127.0.0.1:6379/1   (pip install redis)      memcached://127.0.0.1:11211   (pip install pymemcache)
# Vide = mémoire locale (développement, un seul processus). « python manage.py check --deploy » avertit sinon.
DJANGO_CACHE_URL=

# --- Authentification ----------------------------------------------------------
# Durée d'une session, en heures
DJANGO_SESSION_HOURS=168
# Échecs de connexion tolérés avant blocage, et durée du blocage (secondes ; 300 = 5 minutes).
# Trois compteurs : par (IP + identifiant), par IP seule (un poste qui essaie beaucoup d'identifiants),
# et par identifiant seul (attaque depuis de nombreuses IP). Les deux derniers ont un seuil plus haut.
DJANGO_LOGIN_MAX_ATTEMPTS=5
DJANGO_LOGIN_MAX_ATTEMPTS_PER_IP=20
DJANGO_LOGIN_MAX_ATTEMPTS_PER_USERNAME=20
DJANGO_LOGIN_LOCKOUT_SECONDS=300
# Jours de validité du cookie « appareil de confiance » (posé après une connexion réussie ; il dispense
# le propriétaire du compteur par identifiant seul, pour qu'une attaque distribuée ne l'enferme pas dehors)
DJANGO_LOGIN_TRUSTED_DEVICE_DAYS=30

# --- Import .zip de l'éditeur (protection contre les archives piégées) ----------
# Tailles en Ko. Valeurs par défaut ci-dessous ; au-delà l'import est refusé (HTTP 413).
# EDITOR_ZIP_MAX_UPLOAD_KB=5120     # taille du fichier .zip envoyé
# EDITOR_ZIP_MAX_FILE_KB=1024       # taille décompressée d'un fichier (index.html, style.css, script.js / script.ts, tsconfig.json)
# EDITOR_ZIP_MAX_TOTAL_KB=5120      # total décompressé de toute l'archive
# EDITOR_ZIP_MAX_ENTRIES=100        # nombre de fichiers dans l'archive

# --- Compte administrateur initial (utilisé par « createsuperuser --noinput ») ------
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=
